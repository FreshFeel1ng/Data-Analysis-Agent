# App
APP_NAME=DataAnalysisAgent
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL (app data: users, audit logs, training data)
# 要求数据库已存在；若不存在，先执行: CREATE DATABASE data_agent;
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=data_agent

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_DATABASE=tool_usage
MILVUS_COLLECTION=tool_usage

# LLM Provider: deepseek | openai | ollama
# === DeepSeek (云端, 默认) ===
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=your-deepseek-api-key
# LLM_BASE_URL=https://api.deepseek.com/v1

# === Ollama 本地模型 (零数据外传, 推荐 qwen2.5-coder:14b) ===
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5-coder:14b
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1

# === OpenAI ===
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://api.openai.com/v1

LLM_TEMPERATURE=0
LLM_MAX_TOKENS=8192

# Embedding Provider: local | ollama | openai
# === 本地 bge-small (默认, CPU, 512维) ===
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# === Ollama 嵌入 (全本地, 需先 ollama pull nomic-embed-text) ===
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# === OpenAI 嵌入 ===
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-ada-002

# OpenAI (optional fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Default
LOG_LEVEL=INFO
