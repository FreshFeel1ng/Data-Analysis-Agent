# App
APP_NAME=DataAnalysisAgent
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL (app data: users, audit logs, training data)
# 要求数据库已存在；若不存在，先执行: CREATE DATABASE data_agent;
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=data_agent

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=tool_usage_examples

# LLM Provider: deepseek | openai
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_API_KEY=your-deepseek-api-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=8192

# Embedding: local | openai
# local 模式默认使用 hf-mirror.com 镜像下载模型，国内友好
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# OpenAI (optional fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Default
LOG_LEVEL=INFO
