# App
APP_NAME=DataAnalysisAgent
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL (for app data: users, audit logs, training data)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=data_agent

# Target Databases (user connects to query)
# Format: db_type://user:password@host:port/database
# The app manages multiple DB connections

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=tool_usage_examples

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o

# Default
LOG_LEVEL=INFO
